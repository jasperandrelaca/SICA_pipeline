# Copy to config.env, edit, then:  source config.env
# (config.env is git-ignored)

# Top-level project directory. All other directories default to sub-folders of it.
export CATD_ROOT=/path/to/catd_project

# ---- Optional overrides (defaults shown) ----------------------------------
# export CATD_FMRIPREP_LIST_DIR=$CATD_ROOT/fmriprep_lists     # sub-XXXXX/subject_level_files.txt
# export CATD_FMRIPREP_OUT_DIR=$CATD_ROOT/fmriprep            # denoised runs (P2), read by P3
# export CATD_MELODIC_DIR=$CATD_ROOT/melodic                  # sub-XXXXX_subject_level_ICA.gica/
# export CATD_DUALREG_DIR=$CATD_ROOT/dual_regression          # XXXXX/dr_stage2_subject*.nii.gz
# export CATD_TEMPLATES_DIR=$CATD_ROOT/templates              # MNIPediatricAsym mask + T1w
# export CATD_DERIVED_DIR=$CATD_ROOT/derived                  # downstream outputs
# export CATD_NCT_RESULTS_DIR=$CATD_DERIVED_DIR/nct_results
# export CATD_ASSIGNMENTS_DIR=$CATD_DERIVED_DIR/network_assignments
# export CATD_MASKS_DIR=$CATD_DERIVED_DIR/network_masks

# ---- Cluster-job settings (scripts/01 and scripts/02) ----------------------
# export SUBJECT_LIST=$CATD_ROOT/subjects.txt     # one participant ID per line
# export FSL_MODULE=fsl/6.0.7.15
# export MODULES_INIT=/etc/profile.d/modules.sh   # site-specific `module` init script
# export EXTRA_MODULEPATH=/path/to/site/modulefiles
# export N_COMPONENTS=25                          # MELODIC model order
# export TR=2.5                                   # repetition time (s)
# export N_PERM=100                               # dual_regression randomise permutations

# ---- Preprocessing (scripts/preprocessing/) --------------------------------
# export CATD_BIDS_DIR=/path/to/bids                     # BIDS dataset root
# export CATD_FMRIPREP_OUT_DIR=/path/to/fmriprep_output  # fMRIPrep derivatives
# export CATD_FMRIPREP_SIF=/path/to/fmriprep-22.0.2.sif
# export CATD_FS_LICENSE=/path/to/freesurfer_license.txt # never commit this file
# export BIDS_SUBJECT_LIST=$CATD_ROOT/bids_participants.txt   # BIDS labels, no "sub-"
# export GSR=y                                           # P2 wrapper: y = remove global signal (study), n = keep
# (P3 also needs --gsr y|n and --min-scans N on the command line; the study used y and 3)
# export CONTAINER_CMD=singularity                       # or apptainer
# export FMRIPREP_NPROCS=2  FMRIPREP_MEM_MB=22000        # default: scheduler allocation

# ---- Only if git/SSL fails on your cluster when NCT downloads atlases ------
# (disables certificate verification for git -- use with care)
# export NCT_DISABLE_GIT_SSL_VERIFY=1
